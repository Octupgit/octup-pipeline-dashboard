<?xml version="1.0"?>
<!--
  Generated manifest. Target device is the Garmin Venu X1 only (448 x 486 AMOLED).
  Add further <iq:product> entries if you want to build for other watches.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="42228fb4b807451c9f5aab8acd18cceb"
        type="watchface"
        name="@Strings.AppName"
        entry="FluxApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="venux1"/>
        </iq:products>
        <iq:permissions>
            <!-- Heart rate, Body Battery and stress all come from the sensor history store. -->
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
