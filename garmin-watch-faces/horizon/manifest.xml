<?xml version="1.0"?>
<!--
  Generated manifest. Target device is the Garmin Venu X1 only (448 x 486).
  Add further <iq:product> entries if you want to build for other watches.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="909c7accaaa3477cb68f39d50bab517f"
        type="watchface"
        name="@Strings.AppName"
        entry="HorizonApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0">
        <iq:products>
            <iq:product id="venux1"/>
        </iq:products>
        <iq:permissions>
            <!-- Heart rate, Body Battery and stress all come from the sensor history store. -->
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
